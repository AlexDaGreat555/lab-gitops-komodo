#!/usr/bin/env bash

set -uo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root" || exit 1

readonly version_2_image='python:3.13.8-alpine3.22@sha256:d74ca7409552835ab7517738e9248d8995ad7c42cba30f3278eb3ee120957d3d'
failures=0
temporary_directory=$(mktemp -d)

cleanup() {
  rm --recursive --force -- "$temporary_directory"
}
trap cleanup EXIT

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

for command in docker python3 curl git; do
  if ! command -v "$command" >/dev/null 2>&1; then
    record_failure "$command is not available; reopen this repository in its devcontainer"
  fi
done

if ((failures > 0)); then
  printf '\nLab check stopped because required tools are unavailable.\n' >&2
  exit 1
fi

compose_json="$temporary_directory/compose.json"
declarations_valid=true
if [[ -n "$(git status --porcelain --untracked-files=no -- compose.yml lab04/stack.toml)" ]]; then
  record_failure "compose.yml and lab04/stack.toml must be committed before checking the deployment"
  declarations_valid=false
fi

if ! docker compose config --quiet; then
  record_failure "compose.yml is not valid Docker Compose configuration"
  declarations_valid=false
elif ! docker compose config --format json > "$compose_json"; then
  record_failure "compose.yml could not be normalized for checking"
  declarations_valid=false
fi

if [[ "$declarations_valid" == true ]] && ! python3 - "$compose_json" "$version_2_image" <<'PY'
import json
import sys

compose_path, version_2_image = sys.argv[1:]

with open(compose_path, encoding="utf-8") as stream:
    compose = json.load(stream)

service = compose.get("services", {}).get("lab04-service", {})
if service.get("image") != version_2_image:
    print(
        "Declaration check: lab04-service must use the supplied version 2 digest",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
then
  record_failure "compose.yml does not declare the final lab image"
  declarations_valid=false
fi

if [[ "$declarations_valid" == true ]]; then
  current_commit=$(git rev-parse HEAD)
  printf '\nChecking the local Komodo deployment...\n'
  if ! ./scripts/import-stack \
    --verify-deployment \
    lab04/stack.toml \
    "$current_commit"; then
    record_failure "Komodo has not deployed the current commit"
  elif ! ./scripts/smoke-test 'lab04 version 2'; then
    record_failure "Komodo's running service did not report lab04 version 2"
  fi
fi

if ((failures > 0)); then
  printf '\nLab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf '\nAll Lab 4 checks passed.\n'
